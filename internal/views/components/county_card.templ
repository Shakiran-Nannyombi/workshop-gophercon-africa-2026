package components

import "workshop/internal/data"

templ CountyCard(c data.County, regionName string, shape data.Shape) {
	<article id={ "county-" + c.Slug } class={ "card card-link county-card", "region-tint--" + c.Region }>
		<div class="county-card__band">
			<span class="county-card__code num"><span class="sr-only">County code </span>{ CountyCode(c.Code) }</span>
			if shape.D != "" {
				<svg class="county-card__shape" viewBox={ ShapeViewBox(shape.D) } aria-hidden="true" focusable="false">
					<path d={ shape.D }></path>
				</svg>
			}
		</div>
		<div class="county-card__body">
			<h3 class="county-card__name"><a class="stretched" href={ templ.SafeURL("/counties/" + c.Slug) }>{ c.Name }</a></h3>
			<p class="county-card__seat small soft">
				@Icon("pin", "icon-sm")
				Seat: { c.Seat }
			</p>
			<p class="mt-2"><span class={ "chip region-chip", "region-chip--" + c.Region }>{ regionName }</span></p>
			<dl class="county-card__stats">
				<div>
					<dt>People <span class="muted">(2019)</span></dt>
					<dd class="num">~{ Commas(c.Pop2019) }</dd>
				</div>
				<div>
					<dt>Area</dt>
					<dd class="num">~{ Commas(c.AreaKm2) } km²</dd>
				</div>
			</dl>
			if len(c.GoodFor) > 0 {
				<ul class="cluster county-card__tags" aria-label="Good for">
					for _, g := range firstN(c.GoodFor, 3) {
						<li class="chip chip--surface">{ GoodForLabel(g) }</li>
					}
				</ul>
			}
			if c.Confidence == "limited" {
				<p class="county-card__limited">
					@Icon("info", "icon-sm")
					Limited data
				</p>
			}
		</div>
	</article>
}
