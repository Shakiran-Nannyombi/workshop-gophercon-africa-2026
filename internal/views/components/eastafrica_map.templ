package components

templ EastAfricaMap(p EastAfricaMapProps) {
	<figure class={ "ea-map card", templ.KV("ea-map--compact", p.Compact) }>
		<svg viewBox={ eaViewBox } class="ea-map__svg" role="group" aria-labelledby={ eaTitleID(p) }>
			<title id={ eaTitleID(p) }>
				if p.Compact {
					Locator map of East Africa with { p.Countries[cityCountry(p)] } highlighted
				} else {
					Map of East Africa showing Kenya, Uganda, Tanzania, Rwanda and Ethiopia with the 13 featured cities
				}
			</title>
			<rect class="ea-sea" x="0" y="150" width="620" height="800"></rect>
			<g class="ea-countries">
				for _, c := range p.Geo.Countries {
					<path class={ eaCountryClass(c.Code), templ.KV("ea-country--here", p.Compact && c.Code == cityCountry(p)) } d={ c.D }>
						<title>{ c.Name }</title>
					</path>
				}
			</g>
			<g class="ea-lakes" pointer-events="none">
				for _, l := range p.Geo.Lakes {
					<path class="ea-lake" d={ l.D }></path>
				}
			</g>
			if !p.Compact {
				<g class="ea-labels" pointer-events="none" aria-hidden="true">
					for _, c := range p.Geo.Countries {
						if x, y, ok := eaCountryLabel(c.Code); ok {
							<text class={ "ea-country-label", templ.KV("ea-country-label--featured", featuredCountries[c.Code]) } x={ x } y={ y }>{ c.Name }</text>
						}
					}
					<text class="ea-water-label" x="170" y="690">L. Victoria</text>
					<text class="ea-water-label" x="330" y="470" text-anchor="start">L. Turkana</text>
					<text class="ea-water-label ea-water-label--sea" x="545" y="830">Indian Ocean</text>
				</g>
				<g class="ea-dodoma" aria-hidden="true">
					{{ dx, dy := dodomaXY(p.Geo.Projection) }}
					<circle cx={ dx } cy={ dy } r="5"></circle>
					<text x={ dx } y={ dy } dx="-9" dy="5" text-anchor="end">Dodoma</text>
				</g>
			}
			<g class="ea-cities">
				for _, c := range mapCities(p) {
					<a class={ eaCityClass(c) } href={ templ.SafeURL("/cities/" + c.Slug) } aria-label={ cityAria(c, p.Countries[c.Country]) }>
						<title>{ cityAria(c, p.Countries[c.Country]) }</title>
						if c.Current {
							<circle class="ea-city__ring" cx={ c.X } cy={ c.Y } r="16"></circle>
						}
						if c.Capital {
							<path class="ea-city__mark" d={ starPath(c, 11) }></path>
						} else {
							<circle class="ea-city__mark" cx={ c.X } cy={ c.Y } r="6.5"></circle>
						}
						if showLabel(p, c) {
							<text class="ea-city__label" x={ c.LX } y={ c.LY } text-anchor={ c.Anchor }>{ c.Name }</text>
						}
					</a>
				}
			</g>
		</svg>
		if p.Compact {
			<figcaption class="ea-map__legend ea-map__legend--compact">
				<span class="ea-key ea-key--here" aria-hidden="true"></span>
				<span>{ cityName(p) } in { p.Countries[cityCountry(p)] }. <a class="link" href="/cities#map">See all cities on the map</a></span>
			</figcaption>
		} else {
			<figcaption class="ea-map__legend">
				<ul class="cluster" style="--gap:.5rem 1.1rem">
					<li class="legend-item"><span class="ea-key ea-key--star" aria-hidden="true"></span> National capital</li>
					<li class="legend-item"><span class="ea-key ea-key--dot" aria-hidden="true"></span> Featured city</li>
					<li class="legend-item"><span class="ea-key ea-key--dodoma" aria-hidden="true"></span> Dodoma, Tanzania’s capital (not featured)</li>
					<li class="legend-item"><span class="ea-key ea-key--land" aria-hidden="true"></span> Featured country</li>
					<li class="legend-item"><span class="ea-key ea-key--lake" aria-hidden="true"></span> Lake</li>
				</ul>
				<p class="small muted mt-2">Borders: { p.Geo.Source } ({ p.Geo.License }), simplified. Dots are approximate. Select a city to open its guide.</p>
			</figcaption>
		}
	</figure>
}
