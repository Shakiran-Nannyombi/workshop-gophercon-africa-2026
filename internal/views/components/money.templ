package components

import "workshop/internal/data"

// Banknote is an illustrated (not to scale, not a reproduction) note of currency cur.
templ Banknote(n data.Denomination, i int, cur *data.Currency) {
	<figure class="banknote" style={ templ.SafeCSS(noteTilt(i)) }>
		<svg viewBox="0 0 320 160" role="img" aria-labelledby={ "note-" + cur.Code + itoa(n.Value) }>
			<title id={ "note-" + cur.Code + itoa(n.Value) }>Illustration of a { Commas(n.Value) } { cur.Name } note (not a reproduction)</title>
			<rect x="2" y="2" width="316" height="156" rx="12" fill={ safeColour(n.Colour) } stroke="#1e1a16" stroke-width="3"></rect>
			<rect x="10" y="10" width="300" height="140" rx="8" fill="none" stroke="#fff" stroke-opacity=".45" stroke-width="1.5" stroke-dasharray="2 3"></rect>
			<g fill="none" stroke="#fff" stroke-opacity=".35" stroke-width="1">
				<path d={ guilloche(72, 92, 46, 9) }></path>
				<path d={ guilloche(72, 92, 34, 7) }></path>
				<path d={ guilloche(72, 92, 22, 11) }></path>
			</g>
			<ellipse cx="262" cy="88" rx="34" ry="44" fill="#fff" fill-opacity=".22"></ellipse>
			<path d="M226 12 V148" stroke="#fff" stroke-opacity=".6" stroke-width="2.5" stroke-dasharray="6 4"></path>
			<g fill="#1e1a16" fill-opacity=".55">
				<rect x="150" y="70" width="16" height="64"></rect>
				<ellipse cx="158" cy="68" rx="20" ry="5"></ellipse>
				<rect x="154" y="58" width="8" height="8"></rect>
				<path d="M172 134 L192 96 L212 134Z"></path>
				<rect x="122" y="112" width="104" height="22" rx="2"></rect>
			</g>
			<text x="20" y="40" fill="#fff" font-family="Bricolage Grotesque, sans-serif" font-weight="800" font-size={ noteFont(n.Value, 30) }>{ Commas(n.Value) }</text>
			<text x="22" y="56" fill="#fff" fill-opacity=".9" font-family="JetBrains Mono, monospace" font-size="8" letter-spacing="1.2">{ upper(cur.Issuer) }</text>
			<text x="300" y="146" text-anchor="end" fill="#fff" font-family="Bricolage Grotesque, sans-serif" font-weight="800" font-size={ noteFont(n.Value, 20) }>{ Commas(n.Value) }</text>
			<text x="122" y="128" fill="#fff" fill-opacity=".85" font-family="Figtree, sans-serif" font-size="8.5" font-weight="700">{ upper(cur.Name) }</text>
		</svg>
		<figcaption>
			<span class="banknote__value num">{ cur.Symbol } { Commas(n.Value) }</span>
			<span class="banknote__feature">{ n.Feature }</span>
		</figcaption>
	</figure>
}

templ Coin(c data.Denomination, cur *data.Currency) {
	<figure class="coin-wrap">
		<svg class="coin" viewBox="0 0 100 100" role="img" aria-labelledby={ "coin-" + cur.Code + itoa(c.Value) }>
			<title id={ "coin-" + cur.Code + itoa(c.Value) }>Illustration of a { itoa(c.Value) } { cur.Name } coin (not a reproduction)</title>
			<defs>
				<radialGradient id={ "cg-" + cur.Code + itoa(c.Value) } cx="35%" cy="30%" r="75%">
					<stop offset="0" stop-color="#fffbe8"></stop>
					<stop offset=".45" stop-color={ safeColour(c.Colour) }></stop>
					<stop offset="1" stop-color="#5a4a2a"></stop>
				</radialGradient>
			</defs>
			<circle cx="50" cy="50" r="46" fill={ "url(#cg-" + cur.Code + itoa(c.Value) + ")" } stroke="#1e1a16" stroke-width="3"></circle>
			if c.Value >= 10 {
				<circle cx="50" cy="50" r="30" fill="#c9a43a" fill-opacity=".55" stroke="#1e1a16" stroke-opacity=".5" stroke-width="1.5"></circle>
			}
			<circle cx="50" cy="50" r="40" fill="none" stroke="#1e1a16" stroke-opacity=".35" stroke-dasharray="1.5 2.5"></circle>
			<text x="50" y="60" text-anchor="middle" font-family="Bricolage Grotesque, sans-serif" font-weight="800" font-size="30" fill="#1e1a16">{ itoa(c.Value) }</text>
		</svg>
		<figcaption>
			<span class="coin__value num">{ cur.Symbol } { itoa(c.Value) }</span>
			<span class="coin__feature">{ c.Feature }</span>
		</figcaption>
	</figure>
}

templ PriceTable(prices []data.PriceExample, perUSD float64) {
	<div class="card table-card">
		<div class="table-scroll">
			<table class="data-table price-table">
				<caption class="sr-only">Approximate prices in Kenyan shillings</caption>
				<thead>
					<tr>
						<th scope="col">What</th>
						<th scope="col">Price</th>
						<th scope="col">In US$</th>
						<th scope="col">Good to know</th>
					</tr>
				</thead>
				<tbody>
					for _, p := range prices {
						<tr>
							<th scope="row">{ p.Item }</th>
							<td class="num nowrap">~{ KESRange(p) }</td>
							<td class="num nowrap soft">{ USDRange(p, perUSD) }</td>
							<td class="soft">{ p.Note }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

// Phone is a simple handset mockup; children render on its screen.
templ Phone(label string) {
	<figure class="phone" role="group" aria-label={ label }>
		<div class="phone__body">
			<div class="phone__notch"></div>
			<div class="phone__screen">
				{ children... }
			</div>
		</div>
	</figure>
}
