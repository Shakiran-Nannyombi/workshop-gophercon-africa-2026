package pages

import (
	"workshop/internal/data"
	"workshop/internal/views/components"
	"workshop/internal/views/layouts"
)

templ Cities(m layouts.Meta, s *data.Store) {
	@layouts.Base(m) {
		@components.SectionHero(components.HeroProps{
			Eyebrow: "East Africa · " + itoa(len(s.Cities)) + " cities",
			Title:   "Thirteen cities, five countries, one guide.",
			Lede:    "From Nairobi’s skyline to Stone Town’s alleys: what each city is like, how money works there, and how to get around.",
			Motif:   "rift",
		}) {
			<div class="cluster hero__actions">
				<a class="btn btn--gold" href="#map">
					@components.Icon("map", "icon-sm")
					See the map
				</a>
				<a class="btn" href="/compare">
					@components.Icon("compare", "icon-sm")
					Compare two cities
				</a>
				@components.LastReviewed(s.Site.LastReviewed)
			</div>
		}
		<nav class="toc" aria-label="Countries on this page">
			<ul class="wrap">
				<li><a href="#map">Map</a></li>
				for _, g := range citiesByCountry(s) {
					<li><a href={ templ.SafeURL("#country-" + g.Country.Code) }>{ g.Country.Name }</a></li>
				}
				<li><a href="#compare">Compare</a></li>
			</ul>
		</nav>
		@citiesMapSection(s)
		for i, g := range citiesByCountry(s) {
			@citiesCountry(g, i%2 == 1)
		}
		@citiesCompareBand(s)
	}
}

templ citiesMapSection(s *data.Store) {
	<section id="map" class="section" aria-labelledby="map-title">
		<div class="wrap cities-map">
			<div class="cities-map__intro">
				<p class="eyebrow">The lie of the land</p>
				<h2 id="map-title" class="display-lg mt-3">Where everything is.</h2>
				<p class="lede mt-4">
					Five countries around Lake Victoria and the Rift Valley. Stars are capitals; tap any dot to open that city’s guide.
				</p>
				<ul class="cities-map__countries mt-5">
					for _, g := range citiesByCountry(s) {
						<li>
							<a class={ "country-row", "country-row--" + g.Country.Code } href={ templ.SafeURL("#country-" + g.Country.Code) }>
								@components.Flag(&g.Country)
								<span class="country-row__name">{ g.Country.Name }</span>
								<span class="chip num">{ g.Country.CurrencyCode }</span>
								<span class="country-row__count num">{ itoa(len(g.Cities)) }</span>
								<span class="sr-only">cities</span>
							</a>
						</li>
					}
				</ul>
				<p class="small muted mt-4">
					Distances look short on a map this size. Nairobi to Kampala is a ~1 hour flight or a long day on the road.
				</p>
			</div>
			@components.EastAfricaMap(citiesMap(s, "", false))
		</div>
	</section>
}

templ citiesCountry(g cityCountryGroup, alt bool) {
	<section id={ "country-" + g.Country.Code } class={ "section", "country-block", templ.KV("section--alt", alt) } aria-labelledby={ "country-title-" + g.Country.Code }>
		<div class="wrap">
			<header class="country-head">
				<div class="country-head__name">
					<span class="country-head__flag">
						@components.Flag(&g.Country)
					</span>
					<div>
						<p class="eyebrow">{ itoa(len(g.Cities)) } featured { citiesPlural(len(g.Cities)) }</p>
						<h2 id={ "country-title-" + g.Country.Code } class="display-md">{ g.Country.Name }</h2>
					</div>
				</div>
				<dl class="country-head__facts">
					<div>
						<dt>Currency</dt>
						<dd class="cluster" style="--gap:.35rem">
							<span class="chip chip--gold num">{ g.Country.CurrencyCode } · { g.Country.Symbol }</span>
							<span class="small">{ g.Country.Currency }</span>
						</dd>
					</div>
					<div>
						<dt>Mobile money</dt>
						<dd class="cluster" style="--gap:.35rem">
							for _, mm := range g.Country.MobileMoney {
								<span class="chip chip--surface">
									@components.Icon("phone", "icon-sm")
									{ mm }
								</span>
							}
						</dd>
					</div>
				</dl>
			</header>
			<div class="city-grid reveal-stagger">
				for _, c := range g.Cities {
					@components.CityCard(c, &g.Country)
				}
				<aside class="card country-note" aria-label={ "About " + g.Country.Name }>
					<p class="eyebrow">Good to know in { g.Country.Name }</p>
					<dl class="country-note__facts">
						<div>
							<dt>Languages</dt>
							<dd>{ joinWords(g.Country.Languages) }</dd>
						</div>
						<div>
							<dt>Price check <span class="approx" title="Approximate figure: check before relying on it">~ approx</span></dt>
							<dd>{ g.Country.Scale }</dd>
						</div>
					</dl>
					<a class="link-arrow" href="/money">
						Money explained
						@components.Icon("arrow", "icon-sm")
					</a>
				</aside>
			</div>
		</div>
	</section>
}

templ citiesCompareBand(s *data.Store) {
	<section id="compare" class="section" aria-labelledby="compare-title">
		<div class="wrap">
			<div class="compare-band card">
				<div class="kitenge-dots compare-band__art" aria-hidden="true">
					<span class="compare-band__vs">A <i>vs</i> B</span>
				</div>
				<div class="compare-band__body">
					<p class="eyebrow">Can’t decide?</p>
					<h2 id="compare-title" class="display-md mt-3">Compare two cities side by side.</h2>
					<p class="mt-3 soft">Cost, getting around, climate, safety and nightlife for any pair, with the reasons behind each rating.</p>
					<div class="cluster mt-5">
						<a class="btn btn--gold" href="/compare">
							@components.Icon("compare", "icon-sm")
							Compare two cities
						</a>
						<a class="btn" href={ templ.SafeURL(cityCompareURL("nairobi", "kampala")) }>Nairobi vs Kampala</a>
						<a class="btn" href={ templ.SafeURL(cityCompareURL("dar-es-salaam", "zanzibar-city")) }>Dar vs Zanzibar</a>
					</div>
				</div>
			</div>
			<div class="mt-7 editor-note">
				@components.Callout("info", "Editors: add a city") {
					<p>
						Every city page shares one layout. To add a city, add an object to <code>data/cities.json</code> with a slug, country code,
						lat/lon and a motif (skyline, coast, lake, rift, highland, hills, mountain, river or island). It appears here, on the map and in compare automatically.
					</p>
				}
			</div>
		</div>
	</section>
}
