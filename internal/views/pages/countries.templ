package pages

import (
	"workshop/internal/data"
	"workshop/internal/views/components"
	"workshop/internal/views/layouts"
)

templ CountriesHub(m layouts.Meta, s *data.Store) {
	@layouts.Base(m) {
		@components.SectionHero(components.HeroProps{
			Eyebrow: "Countries",
			Title:   "Ten countries, one region.",
			Lede:    "Capitals, currencies, how addresses work and how to get in, for each country in East Africa and the Horn. Tap a country on the map or pick one below.",
			Motif:   "rift",
		})
		<section class="section" aria-labelledby="map-title">
			<div class="wrap split">
				<div>
					<h2 id="map-title" class="display-md">The map</h2>
					<p class="lede mt-3">A star marks each official capital; a dot marks a commercial city where it isn’t the capital. In Tanzania and Burundi the capital and the biggest city are different places.</p>
					@components.EastAfricaMap(s, "", "Map of East Africa: click a country")
				</div>
				<div>
					<h2 class="display-md">In depth</h2>
					<ul class="country-list mt-5">
						for _, c := range fullCountries(s, "full") {
							@countryRow(s, c)
						}
					</ul>
					<h2 class="display-md mt-7">Less data so far</h2>
					<p class="soft mt-2">Shorter pages for now, waiting to be expanded.</p>
					<ul class="country-list mt-5">
						for _, c := range fullCountries(s, "light") {
							@countryRow(s, c)
						}
					</ul>
				</div>
			</div>
		</section>
		<div class="wrap">
			@components.LastReviewed(m.Site.LastReviewed)
		</div>
	}
}

templ countryRow(s *data.Store, c data.Country) {
	<li class="card card-link country-row">
		@components.Flag(&c)
		<div>
			<h3><a class="stretched" href={ templ.SafeURL("/countries/" + c.Slug) }>{ c.Name }</a></h3>
			<p class="small soft">
				@components.Icon("star", "icon-sm")
				{ cityName(s, c.Capital) }
				if c.CommercialCity != "" {
					· commercial hub { cityName(s, c.CommercialCity) }
				}
				· <span class="num">{ c.CurrencyCode }</span>
			</p>
		</div>
		if c.Advisory != nil {
			<span class="chip chip--red">
				@components.Icon("alert", "icon-sm")
				Advisory
			</span>
		}
	</li>
}

templ CountryPage(m layouts.Meta, s *data.Store, c *data.Country) {
	{{ capital, commercial := cityPtr(s, c.Capital), cityPtr(s, c.CommercialCity) }}
	@layouts.Base(m) {
		@components.SectionHero(components.HeroProps{
			Eyebrow: "Country guide",
			Title:   c.Name,
			Lede:    c.Intro,
			Motif:   countryMotif(s, c),
		}) {
			<div class="cluster hero__actions">
				@components.LessData(c.Depth)
			</div>
		}
		<nav class="toc" aria-label="On this page">
			<ul class="wrap">
				<li><a href="#glance">At a glance</a></li>
				<li><a href="#capital">Capital</a></li>
				<li><a href="#organised">How it’s organised</a></li>
				<li><a href="#money">Money</a></li>
				<li><a href="#getting-in">Getting in</a></li>
				<li><a href="#getting-around">Getting around</a></li>
				<li><a href="#map">Map</a></li>
			</ul>
		</nav>
		if c.Advisory != nil {
			<div class="wrap mt-6">
				@components.AdvisoryBanner(c.Name, c.Advisory, s.SourcesOf("advisory"))
			</div>
		}
		<div id="glance" class="wrap section-tight">
			@components.AtAGlance(c, capital, commercial)
		</div>
		<section id="capital" class="section" aria-labelledby="capital-title">
			<div class="wrap">
				<div class="section-head">
					<p class="eyebrow">Capital city</p>
					<h2 id="capital-title" class="display-lg">
						if commercial != nil {
							Two cities to know.
						} else if capital != nil {
							{ capital.Name }.
						}
					</h2>
				</div>
				@components.CapitalBlock(c, capital, commercial)
			</div>
		</section>
		<section id="organised" class="section section--alt" aria-labelledby="org-title">
			<div class="wrap">
				<div class="section-head">
					<p class="eyebrow">Reading an address</p>
					<h2 id="org-title" class="display-lg">How { c.Name } is organised</h2>
					if c.Organisation.Summary != "" {
						<p class="lede">{ c.Organisation.Summary }</p>
					}
				</div>
				@components.OrgLadder(c.Name, c.Organisation, kenyaOrg(s), c.Code == "KE")
			</div>
		</section>
		<section id="money" class="section" aria-labelledby="money-title">
			<div class="wrap split split--even">
				<div>
					<p class="eyebrow">Money</p>
					<h2 id="money-title" class="display-lg">{ c.Currency }</h2>
					<p class="lede mt-3">Prices are written with <strong class="num">{ c.Symbol }</strong>. { c.Scale }</p>
					<a class="btn btn--gold mt-5" href={ templ.SafeURL("/currencies/" + c.CurrencyCode) }>
						The { c.CurrencyCode } guide
						@components.Icon("arrow", "icon-sm")
					</a>
				</div>
				<div class="stack">
					@MentalMaths(s, c.CurrencyCode)
					if len(c.MobileMoney) > 0 {
						<div class="card card--pad">
							<p class="eyebrow">Mobile money</p>
							<ul class="cluster mt-3">
								for _, mm := range c.MobileMoney {
									<li class="chip">
										@components.Icon("phone", "icon-sm")
										{ mm }
									</li>
								}
							</ul>
						</div>
					}
				</div>
			</div>
		</section>
		<section id="getting-in" class="section section--alt" aria-labelledby="in-title">
			<div class="wrap">
				<div class="section-head">
					<p class="eyebrow">Getting in</p>
					<h2 id="in-title" class="display-lg">Arriving in { c.Name }</h2>
				</div>
				@components.RulesChange()
				if len(c.Airports) > 0 {
					<ul class="airport-list mt-6">
						for _, a := range c.Airports {
							<li class="card card--pad airport">
								<span class="airport__code num">{ a.IATA }</span>
								<span>
									<strong>{ a.Name }</strong>
									<span class="small soft">{ cityName(s, a.City) }</span>
								</span>
								if a.Main {
									<span class="chip chip--green">Main</span>
								}
							</li>
						}
					</ul>
				}
				if len(c.GettingIn.AirportToCity) > 0 {
					<h3 class="display-md mt-7">From the airport to the city</h3>
					@components.ModeGrid(c.GettingIn.AirportToCity)
				}
				if len(c.GettingIn.RideHail) > 0 {
					<p class="mt-5"><strong>Ride-hail apps reported in the capital:</strong></p>
					<ul class="cluster mt-2">
						for _, app := range c.GettingIn.RideHail {
							<li class="chip chip--surface">{ app }</li>
						}
					</ul>
				}
				if len(c.GettingIn.Notes) > 0 {
					<ul class="checklist mt-5">
						for _, n := range c.GettingIn.Notes {
							<li>
								@components.Icon("check", "icon-sm")
								<span>{ n }</span>
							</li>
						}
					</ul>
				}
				if bs := crossingsFor(s, c.Code); len(bs) > 0 {
					<h3 class="display-md mt-7">By road: border crossings</h3>
					<ul class="cluster mt-3">
						for _, b := range bs {
							<li><a class="pill" href={ templ.SafeURL("/borders#" + b.Slug) }>
								@components.Icon("border", "icon-sm")
								{ b.Name }
							</a></li>
						}
					</ul>
				}
			</div>
		</section>
		<section id="getting-around" class="section" aria-labelledby="around-title">
			<div class="wrap">
				<div class="section-head">
					<p class="eyebrow">Getting around</p>
					<h2 id="around-title" class="display-lg">
						Moving around
						if capital != nil {
							{ capital.Name }
						}
						if commercial != nil {
							and { commercial.Name }
						}
					</h2>
				</div>
				if len(c.CapitalModes) > 0 {
					@components.ModeGrid(c.CapitalModes)
				} else {
					<p class="card card--pad">Not written yet for this country.</p>
				}
				if rs := routesFor(s, c.Code, ""); len(rs) > 0 {
					<h3 class="display-md mt-7">Routes to and from { c.Name }</h3>
					@routeLinks(s, rs)
				}
			</div>
		</section>
		<section id="map" class="section section--alt" aria-labelledby="cmap-title">
			<div class="wrap-narrow">
				<h2 id="cmap-title" class="display-md">{ c.Name } on the map</h2>
				@components.EastAfricaMap(s, c.Code, "Map of East Africa with "+c.Name+" highlighted")
			</div>
		</section>
		<div class="wrap mt-6">
			@components.LastReviewed(m.Site.LastReviewed)
		</div>
	}
}

templ routeLinks(s *data.Store, rs []data.Route) {
	<ul class="cluster mt-3">
		for _, r := range rs {
			<li>
				<a class="pill" href={ templ.SafeURL("/routes?from=" + r.From + "&to=" + r.To + "#planner") }>
					@components.Icon("route", "icon-sm")
					{ cityName(s, r.From) } → { cityName(s, r.To) }
				</a>
			</li>
		}
	</ul>
}

templ CitiesHub(m layouts.Meta, s *data.Store, country string) {
	@layouts.Base(m) {
		@components.SectionHero(components.HeroProps{
			Eyebrow: "City guides",
			Title:   "Pick a city.",
			Lede:    "Every capital in the region and the big cities around them. Same layout for each, so they’re easy to compare.",
			Motif:   "skyline",
		})
		<section id="cities" class="section" aria-label="Cities">
			<div class="wrap">
				@CityPicker(s, country, "/cities")
			</div>
		</section>
	}
}

templ CityPage(m layouts.Meta, s *data.Store, c *data.City) {
	{{ co := countryOf(s, c.Country) }}
	{{ role := s.CityRole(c.Slug) }}
	{{ advisory := co != nil && co.Advisory != nil }}
	@layouts.Base(m) {
		@components.SectionHero(components.HeroProps{
			Eyebrow: "City guide",
			Title:   c.Name,
			Lede:    c.Tagline,
			Motif:   c.Motif,
		}) {
			<div class="cluster hero__actions">
				if co != nil {
					<a class="chip chip--surface" href={ templ.SafeURL("/countries/" + co.Slug) }>
						@components.Flag(co)
						{ co.Name }
					</a>
				}
				if role != "" {
					<span class="chip chip--gold">
						@components.Icon(roleIcon(role), "icon-sm")
						{ roleLabel(role) }
					</span>
				}
				if c.Confidence == "limited" {
					@components.LessData("light")
				}
			</div>
		}
		if advisory {
			<div class="wrap mt-6">
				@components.AdvisoryBanner(co.Name, co.Advisory, s.SourcesOf("advisory"))
			</div>
		}
		<section class="section-tight wrap">
			<dl class="card city-facts">
				@cityFact("city", "Population", c.Population)
				@cityFact("map", "Elevation", c.Elevation)
				@cityFact("cloud", "Climate", c.Climate)
				@cityFact("plane", "Airport", c.Airport)
				@cityFact("book", "Languages", joinList(c.Languages))
			</dl>
			if c.Intro != "" {
				<p class="lede mt-6">{ c.Intro }</p>
			}
			if co != nil && role == "capital" && co.CapitalNote != "" && co.CommercialCity != "" {
				<div class="mt-5">
					@components.Callout("info", "Capital or main city?") {
						<p>{ co.CapitalNote }</p>
					}
				</div>
			}
		</section>
		if len(c.Neighbourhoods) > 0 && !advisory {
			<section class="section section--alt" aria-labelledby="hoods-title">
				<div class="wrap">
					<h2 id="hoods-title" class="display-lg">Neighbourhoods</h2>
					<ul class="grid-auto mt-5">
						for _, n := range c.Neighbourhoods {
							<li class="card card--pad">
								<h3>{ n.Name }</h3>
								<p class="soft mt-2">{ n.Note }</p>
							</li>
						}
					</ul>
				</div>
			</section>
		}
		<section class="section" aria-labelledby="move-title">
			<div class="wrap">
				<h2 id="move-title" class="display-lg">Getting around</h2>
				if ms := modesFor(s, c); len(ms) > 0 {
					@components.ModeGrid(ms)
				}
				@bulletList("bus", c.Transport)
				if rs := routesFor(s, "", c.Slug); len(rs) > 0 {
					<h3 class="display-md mt-6">Routes from { c.Name }</h3>
					@routeLinks(s, rs)
				}
			</div>
		</section>
		<section class="section section--alt">
			<div class="wrap grid-auto" style="--min:20rem">
				if len(c.MoneyTips) > 0 {
					<div class="card card--pad">
						<h2 class="display-md">Money</h2>
						@bulletList("money", c.MoneyTips)
						if co != nil {
							<a class="link-arrow mt-3" href={ templ.SafeURL("/currencies/" + co.CurrencyCode) }>
								The { co.CurrencyCode } guide
								@components.Icon("arrow", "icon-sm")
							</a>
						}
					</div>
				}
				if len(c.Food) > 0 {
					<div class="card card--pad">
						<h2 class="display-md">Food</h2>
						@bulletList("food", c.Food)
					</div>
				}
				if len(c.Safety) > 0 {
					<div class="card card--pad">
						<h2 class="display-md">Good to know</h2>
						@bulletList("shield", c.Safety)
					</div>
				}
				if len(c.Suits) > 0 {
					<div class="card card--pad">
						<h2 class="display-md">Suits</h2>
						<ul class="cluster mt-3">
							for _, x := range c.Suits {
								<li class="chip">{ x }</li>
							}
						</ul>
					</div>
				}
			</div>
		</section>
		<div class="wrap mt-6 cluster">
			@components.LastReviewed(m.Site.LastReviewed)
			<a class="link" href={ templ.SafeURL("/compare?a=" + c.Slug) }>Compare { c.Name } with another city</a>
		</div>
	}
}

templ cityFact(icon, label, value string) {
	if value != "" {
		<div class="city-facts__item">
			<dt>
				@components.Icon(icon, "icon-sm")
				{ label }
			</dt>
			<dd>{ value }</dd>
		</div>
	}
}

templ bulletList(icon string, items []string) {
	if len(items) > 0 {
		<ul class="checklist mt-4">
			for _, it := range items {
				<li>
					@components.Icon(icon, "icon-sm")
					<span>{ it }</span>
				</li>
			}
		</ul>
	}
}
