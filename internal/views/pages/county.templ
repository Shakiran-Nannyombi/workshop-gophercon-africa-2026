package pages

import (
	"workshop/internal/data"
	"workshop/internal/views/components"
	"workshop/internal/views/layouts"
)

templ CountyPage(m layouts.Meta, s *data.Store, c *data.County) {
	{{ prev, next := countyNeighbours(s, c) }}
	@layouts.Base(m) {
		@components.SectionHero(components.HeroProps{
			Eyebrow: "County " + components.CountyCode(c.Code) + " · " + countyRegionName(s, c.Region) + " region",
			Title:   components.CountyTitle(*c),
			Lede:    countyLede(s, c),
			Motif:   regionMotif(c.Region),
		}) {
			<div class="cluster hero__actions">
				if c.Slug == "nairobi" {
					<a class="btn btn--gold" href="/nairobi">Read the full Nairobi guide</a>
				}
				<a class="btn" href="/counties#all-counties">
					@components.Icon("back", "icon-sm")
					All 47 counties
				</a>
			</div>
		}
		<section class={ "section county-detail", "region-tint--" + c.Region } aria-labelledby="glance-title">
			<div class="wrap">
				if c.Slug == "nairobi" {
					<a class="card card-link nairobi-promo" href="/nairobi">
						<span class="nairobi-promo__text">
							<span class="eyebrow">Deep dive</span>
							<strong class="nairobi-promo__title">Nairobi, explained</strong>
							<span class="soft">The city and county, 50+ areas, which “Nairobi” places are really in Kiambu, Kajiado or Machakos, matatus and weather.</span>
						</span>
						<span class="nairobi-promo__go" aria-hidden="true">
							@components.Icon("arrow", "icon")
						</span>
					</a>
				}
				if c.Confidence == "limited" {
					<div class="mt-5">
						@components.Callout("warn", "Limited data") {
							<p>We have less reliable information on { components.CountyTitle(*c) } than on most counties. Treat the details below as a starting point and check locally before you travel.</p>
						}
					</div>
				}
				<div class="county-glance mt-6">
					<div>
						<div class="card glance-card">
							<div class="glance-card__head">
								<span class="glance-card__code num"><span class="sr-only">County code </span>{ components.CountyCode(c.Code) }</span>
								<div>
									<p class="eyebrow">At a glance</p>
									<h2 id="glance-title" class="display-md">{ c.Name }</h2>
								</div>
							</div>
							<dl class="glance-card__facts">
								<div>
									<dt>County seat</dt>
									<dd>{ c.Seat }</dd>
								</div>
								<div>
									<dt>Region</dt>
									<dd><a class={ "chip region-chip", "region-chip--" + c.Region } href={ templ.SafeURL(regionFilterHref(c.Region)) }>{ countyRegionName(s, c.Region) }</a></dd>
								</div>
								<div>
									<dt>Population <span class="glance-card__sub">2019 census</span></dt>
									<dd class="num">~{ components.Commas(c.Pop2019) }</dd>
								</div>
								<div>
									<dt>Area</dt>
									<dd class="num">~{ components.Commas(c.AreaKm2) } km²</dd>
								</div>
								<div class="glance-card__wide">
									<dt>Density</dt>
									<dd><span class="num">~{ countyDensity(*c) }</span> people per km² @components.Approx("")</dd>
								</div>
							</dl>
						</div>
						if len(c.KnownFor) > 0 {
							<div class="mt-6">
								<h3>Known for</h3>
								<ul class="known-for mt-3">
									for _, k := range c.KnownFor {
										<li>
											@components.Icon("check", "icon-sm")
											<span>{ k }</span>
										</li>
									}
								</ul>
							</div>
						}
					</div>
					<div class="county-locator">
						<div class="card card--pad">
							<p class="eyebrow">Where it is</p>
							@components.KenyaMap(components.KenyaMapProps{Store: s, Current: c.Slug})
						</div>
					</div>
				</div>
			</div>
		</section>
		<section class="section section--alt" aria-labelledby="expect-title">
			<div class="wrap">
				<div class="section-head">
					<p class="eyebrow">What to expect</p>
					<h2 id="expect-title" class="display-lg">Weather, food, getting around, feel.</h2>
				</div>
				<div class="expect-grid mt-6 reveal-stagger">
					@expectCard("Climate", "climate", c.Climate)
					@expectCard("Food", "food", c.Food)
					@expectCard("Getting around", "matatu", c.Transport)
					@expectCard("Vibe", "people", c.Vibe)
				</div>
				<div class="split split--even mt-7">
					if len(c.Towns) > 0 {
						<div>
							<h3>Main towns and places</h3>
							<ul class="town-list mt-4">
								for _, t := range c.Towns {
									<li>
										@components.Icon("pin", "icon-sm")
										{ t }
									</li>
								}
							</ul>
						</div>
					}
					if len(c.GoodFor) > 0 {
						<div>
							<h3>Good for</h3>
							<ul class="cluster mt-4">
								for _, g := range c.GoodFor {
									<li class="chip chip--gold">{ components.GoodForLabel(g) }</li>
								}
							</ul>
						</div>
					}
				</div>
			</div>
		</section>
		<nav class="wrap county-pager mt-7" aria-label="Browse counties">
			<a class="card card-link county-pager__link" href={ templ.SafeURL("/counties/" + prev.Slug) } rel="prev">
				<span class="county-pager__dir">
					@components.Icon("back", "icon-sm")
					Previous
				</span>
				<span class="county-pager__name"><span class="num">{ components.CountyCode(prev.Code) }</span> { prev.Name }</span>
			</a>
			<a class="county-pager__all link-arrow" href="/counties#all-counties">All counties</a>
			<a class="card card-link county-pager__link county-pager__link--next" href={ templ.SafeURL("/counties/" + next.Slug) } rel="next">
				<span class="county-pager__dir">
					Next
					@components.Icon("arrow", "icon-sm")
				</span>
				<span class="county-pager__name"><span class="num">{ components.CountyCode(next.Code) }</span> { next.Name }</span>
			</a>
		</nav>
		<div class="wrap mt-6">
			@components.LastReviewed(s.Site.LastReviewed)
		</div>
	}
}

templ expectCard(title, art, body string) {
	<article class="card card--pad expect-card">
		<div class="expect-card__head">
			if art == "climate" {
				<span class="expect-card__icon" aria-hidden="true">
					@components.Icon("cloud", "icon-lg")
				</span>
			} else {
				@components.Art(art, "expect-card__art")
			}
			<h3>{ title }</h3>
		</div>
		<p class="soft mt-3">{ body }</p>
	</article>
}
