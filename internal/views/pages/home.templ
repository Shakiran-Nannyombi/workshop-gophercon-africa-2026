package pages

import (
	"workshop/internal/data"
	"workshop/internal/views/components"
	"workshop/internal/views/layouts"
)

type step struct {
	N, Title, Body, Href, Icon, Cta string
}

var startSteps = []step{
	{"1", "Money", "Shillings, M-Pesa, and what things actually cost.", "/money", "money", "Understand the money"},
	{"2", "Where am I?", "47 counties, and why “Nairobi” is often not Nairobi.", "/counties", "map", "Read the map"},
	{"3", "Getting around", "Matatus, boda bodas, ride-hailing and the SGR train.", "/nairobi#getting-around", "bus", "Learn to move"},
	{"4", "Pick a city", "From Nairobi to Kigali: what each city is like.", "/cities", "city", "Choose a city"},
}

templ Home(m layouts.Meta, s *data.Store, country string) {
	@layouts.Base(m) {
		@components.SectionHero(homeHero(country)) {
			<div class="cluster hero__actions">
				<a class="btn btn--gold" href="#start">
					Start here
					@components.Icon("arrow", "icon-sm")
				</a>
				<a class="btn" href="#cities">Pick a city</a>
			</div>
		}
		@homeGlance(s, country, false)
		@startHere()
		@components.KangaBand()
		@cityPickerSection(s, country)
	}
}

// HomeCountry answers a country pill click: the city list, plus the hero
// copy and Money/Map/Pay cards swapped in out of band.
templ HomeCountry(s *data.Store, country string) {
	@CityPicker(s, country)
	@components.HeroCopy(homeHero(country), true)
	@homeGlance(s, country, true)
}

templ homeGlance(s *data.Store, country string, oob bool) {
	<section
		id="home-glance"
		class="wrap home-glance"
		aria-label="Things that help you get oriented"
		if oob {
			hx-swap-oob="true"
		}
	>
		@countryPills(s, country, "")
		<ul class="facts reveal-stagger is-in" aria-live="polite">
			for _, f := range homeFacts(s, country) {
				<li class="card fact">
					<p class="eyebrow">{ f.Eyebrow }</p>
					<p class={ "fact__big", templ.KV("num", f.USD != "") }>{ f.Big }</p>
					<p>
						{ f.Body }
						if f.USD != "" {
							<strong class="num">US${ f.USD }</strong>
							@components.Approx("")
						}
					</p>
				</li>
			}
		</ul>
	</section>
}

templ countryPills(s *data.Store, country, hash string) {
	<div class="cluster home-glance__pills" role="group" aria-label="Choose a country">
		for _, c := range s.Countries {
			<a
				class="pill"
				href={ templ.SafeURL("/?country=" + c.Code + hash) }
				hx-get={ "/?country=" + c.Code }
				hx-target="#city-picker"
				hx-swap="outerHTML"
				hx-push-url={ "/?country=" + c.Code }
				if c.Code == country {
					aria-current="true"
				}
			>
				@components.Flag(&c)
				{ c.Name }
			</a>
		}
	</div>
}

templ startHere() {
	<section id="start" class="section" aria-labelledby="start-title">
		<div class="wrap">
			<div class="section-head">
				<p class="eyebrow">The route</p>
				<h2 id="start-title" class="display-lg">Start here. Four stops, like a matatu route.</h2>
				<p class="lede">Each stop answers one confusing thing. Do them in order, or jump to the one that’s bothering you.</p>
			</div>
			<ol class="route">
				for _, st := range startSteps {
					<li class="route__stop reveal">
						<span class="route__num" aria-hidden="true">{ st.N }</span>
						<div class="card card-link route__card">
							<div class="route__head">
								@components.Icon(st.Icon, "icon")
								<h3><span class="sr-only">Stop { st.N }: </span>{ st.Title }</h3>
							</div>
							<p>{ st.Body }</p>
							<a class="stretched link-arrow" href={ templ.SafeURL(st.Href) }>
								{ st.Cta }
								@components.Icon("arrow", "icon-sm")
							</a>
						</div>
					</li>
				}
			</ol>
		</div>
	</section>
}

templ cityPickerSection(s *data.Store, country string) {
	<section id="cities" class="section kitenge-dots" aria-labelledby="cities-title">
		<div class="wrap">
			<div class="section-head">
				<p class="eyebrow">City picker</p>
				<h2 id="cities-title" class="display-lg">Pick a city.</h2>
				<p class="lede">{ itoa(len(s.Cities)) } cities across { itoa(len(s.Countries)) } countries. Choose a country to see its cities.</p>
			</div>
			@CityPicker(s, country)
		</div>
	</section>
}

templ CityPicker(s *data.Store, country string) {
	<div id="city-picker" class="mt-6">
		@countryPills(s, country, "#cities")
		{{ cities := citiesIn(s, country) }}
		if len(cities) == 0 {
			<p class="card card--pad mt-6">No city guides here yet. See <a class="link" href="/cities">all cities</a>.</p>
		} else {
			<div class="city-grid" aria-live="polite">
				for _, c := range cities {
					{{ co, _ := s.Country(c.Country) }}
					@components.CityCard(c, co)
				}
			</div>
		}
	</div>
}
