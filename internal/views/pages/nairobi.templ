package pages

import (
	"workshop/internal/data"
	"workshop/internal/views/components"
	"workshop/internal/views/layouts"
)

var nairobiTOC = []struct{ ID, Label string }{
	{"city-and-county", "City or county?"},
	{"map", "The map"},
	{"which-county", "Which county?"},
	{"areas", "Area guide"},
	{"ruaka", "Ruaka"},
	{"getting-around", "Getting around"},
	{"practical", "SIM, food, safety"},
	{"weather", "Weather"},
}

templ Nairobi(m layouts.Meta, s *data.Store, f AreaFilter, l Lookup) {
	@layouts.Base(m) {
		@components.SectionHero(components.HeroProps{
			Eyebrow: "Deep dive · Nairobi",
			Title:   "Nairobi, explained.",
			Lede:    "A city, a county, and a sprawl that spills into three other counties. Here’s how to make sense of it, and how to get around.",
			Motif:   "skyline",
		}) {
			<div class="cluster hero__actions">
				<a class="btn btn--gold" href="#which-county">Which county am I in?</a>
				<a class="btn" href="#areas">Browse { itoa(len(s.Areas)) } areas</a>
			</div>
		}
		<nav class="toc" aria-label="On this page">
			<ul class="wrap">
				for _, t := range nairobiTOC {
					<li><a href={ templ.SafeURL("#" + t.ID) }>{ t.Label }</a></li>
				}
			</ul>
		</nav>
		@cityAndCounty(s)
		@nairobiMapSection(s)
		@whichCountySection(l)
		@areaGuide(s, f)
		@ruakaSpotlight(s)
		@gettingAround(s)
		@practical(s)
		@weatherSection(s.Nairobi.Weather)
		<div class="wrap mt-6">
			@components.LastReviewed(s.Site.LastReviewed)
		</div>
	}
}

templ cityAndCounty(s *data.Store) {
	<section id="city-and-county" class="section" aria-labelledby="cc-title">
		<div class="wrap split">
			<div>
				<p class="eyebrow">The big confusion</p>
				<h2 id="cc-title" class="display-lg mt-3">One name, two things, four counties.</h2>
				<div class="prose lede mt-5">
					for _, p := range s.Nairobi.CityVsCounty {
						<p>{ p }</p>
					}
				</div>
				<p class="soft mt-4">{ s.Nairobi.MetroNote }</p>
			</div>
			<figure class="card card--pad concept reveal" aria-labelledby="concept-cap">
				<svg viewBox="0 0 400 360" role="img" aria-labelledby="concept-title">
					<title id="concept-title">Diagram: Nairobi City County in the centre, with the Nairobi everyone talks about spilling over into Kiambu to the north, Machakos to the east and Kajiado to the south</title>
					<path d="M200 22 C300 22 380 90 380 180 S300 340 200 340 S20 270 20 180 S100 22 200 22Z" fill="none" stroke="var(--red)" stroke-width="3" stroke-dasharray="10 8"></path>
					<text x="200" y="48" text-anchor="middle" class="concept__label concept__label--red">“Nairobi”, as people say it</text>
					<path d="M200 95 C260 92 300 130 298 180 C296 232 258 262 200 262 C140 262 104 228 104 180 C104 128 142 98 200 95Z" fill="var(--gold)" stroke="var(--line)" stroke-width="3"></path>
					<text x="200" y="172" text-anchor="middle" class="concept__big">Nairobi</text>
					<text x="200" y="196" text-anchor="middle" class="concept__small">City = County</text>
					<text x="200" y="214" text-anchor="middle" class="concept__small">(Nairobi City County)</text>
					<text x="200" y="84" text-anchor="middle" class="concept__county">KIAMBU ↑</text>
					<text x="345" y="186" text-anchor="middle" class="concept__county">MACHAKOS</text>
					<text x="345" y="204" text-anchor="middle" class="concept__county">→</text>
					<text x="200" y="292" text-anchor="middle" class="concept__county">KAJIADO ↓</text>
					<text x="60" y="186" text-anchor="middle" class="concept__county">KIAMBU</text>
					<text x="60" y="204" text-anchor="middle" class="concept__county">←</text>
				</svg>
				<figcaption id="concept-cap" class="small soft">The gold shape is the official city and county. The dashed line is the wider area people casually call “Nairobi”.</figcaption>
			</figure>
		</div>
	</section>
}

templ nairobiMapSection(s *data.Store) {
	<section id="map" class="section section--alt" aria-labelledby="map-title">
		<div class="wrap">
			<div class="section-head">
				<p class="eyebrow">Nairobi explained · the map</p>
				<h2 id="map-title" class="display-lg">Where “Nairobi” really ends.</h2>
				<p class="lede">The gold county is Nairobi. Everything hatched is a neighbouring county, even if the matatu says “Nairobi”. Zoom in, then click a dot to jump to that area.</p>
			</div>
			<div class="mt-6">
				@components.NairobiMap(components.NairobiMapProps{Geo: s.Geo.Nairobi, Areas: s.Areas, Roads: s.Nairobi.Roads, CountyFor: s.CountyName})
			</div>
			<h3 class="mt-7">They say “Nairobi”, but…</h3>
			<div class="outside-board mt-4">
				for _, g := range outsideByCounty(s) {
					<div class={ "card outside-board__col", "outside-board__col--" + g.Slug }>
						<p class="eyebrow">Actually in</p>
						<p class="outside-board__county">{ g.Name } County</p>
						<ul class="cluster mt-3" style="--gap:.4rem">
							for _, a := range g.Areas {
								<li><a class="chip chip--surface" href={ templ.SafeURL("#area-" + a.Slug) }>{ a.Name }</a></li>
							}
						</ul>
					</div>
				}
			</div>
		</div>
	</section>
}

templ whichCountySection(l Lookup) {
	<section id="which-county" class="section" aria-labelledby="wc-title">
		<div class="wrap" style="max-width:52rem">
			<div class="section-head">
				<p class="eyebrow">Lookup</p>
				<h2 id="wc-title" class="display-lg">Which county am I really in?</h2>
				<p class="lede">Type the name of the place on your booking, your office or your friend’s address.</p>
			</div>
			<form class="mt-6" action="/nairobi#which-county" method="get" hx-get="/nairobi" hx-target="#which-result" hx-swap="outerHTML" hx-trigger="input delay:250ms from:#where, submit">
				<label class="label" for="where">Place name</label>
				<div class="field-wrap">
					@components.Icon("search", "icon-sm")
					<input class="field" id="where" name="where" type="search" autocomplete="off" placeholder="e.g. Ruaka, Rongai, Syokimau" value={ l.Query }/>
				</div>
				<div class="cluster mt-3" style="--gap:.4rem">
					<span class="small muted">Try:</span>
					for _, ex := range whichExamples {
						<a class="chip" href={ templ.SafeURL("/nairobi?where=" + ex + "#which-county") } hx-get={ "/nairobi?where=" + ex } hx-target="#which-result" hx-swap="outerHTML">{ ex }</a>
					}
				</div>
				<noscript><button class="btn btn--gold mt-3" type="submit">Look it up</button></noscript>
			</form>
			@WhichResult(l)
		</div>
	</section>
}

templ WhichResult(l Lookup) {
	<div id="which-result" class="which mt-6" aria-live="polite">
		if l.Query == "" {
		} else if l.Best == nil {
			@components.Callout("info", "Not in our list yet") {
				<p>We don’t have “{ l.Query }” yet. It may be a smaller estate inside one of the areas below. Try a nearby landmark or the main road.</p>
			}
		} else {
			<div class={ "card which__card", templ.KV("which__card--outside", l.Best.County != "nairobi") }>
				<p class="eyebrow">{ l.Best.Name } is in</p>
				<p class="which__county">{ countyTitle(l.Best.County) } County</p>
				if l.Best.County == "nairobi" {
					<p class="soft">Yes, this one really is Nairobi: inside Nairobi City County.</p>
				} else {
					<p class="soft">People often say “Nairobi”, but officially it’s <strong>{ countyTitle(l.Best.County) } County</strong>. County fees, services and elections there are { countyTitle(l.Best.County) }’s.</p>
				}
				<p class="mt-3"><a class="link-arrow" href={ templ.SafeURL("#area-" + l.Best.Slug) }>Read about { l.Best.Name } @components.Icon("arrow", "icon-sm")</a></p>
			</div>
			if len(l.Others) > 0 {
				<p class="small muted mt-3">Did you mean:</p>
				<ul class="cluster mt-2" style="--gap:.4rem">
					for _, o := range l.Others {
						<li><a class="chip" href={ templ.SafeURL("/nairobi?where=" + o.Name + "#which-county") } hx-get={ "/nairobi?where=" + o.Name } hx-target="#which-result" hx-swap="outerHTML">{ o.Name } · { countyTitle(o.County) }</a></li>
					}
				</ul>
			}
		}
	</div>
}

templ areaGuide(s *data.Store, f AreaFilter) {
	<section id="areas" class="section section--alt" aria-labelledby="areas-title">
		<div class="wrap">
			<div class="section-head">
				<p class="eyebrow">Area guide</p>
				<h2 id="areas-title" class="display-lg">{ itoa(len(s.Areas)) } areas, in plain words.</h2>
				<p class="lede">
					Cost levels are rough (rent and eating out), and safety notes are the same common sense that applies across the city.
					{ itoa(limitedCount(s.Areas)) } areas are marked where we have less data.
				</p>
			</div>
			<form class="filters card mt-6" action="/nairobi#areas" method="get" hx-get="/nairobi" hx-target="#area-results" hx-swap="outerHTML" hx-push-url="true" hx-trigger="input delay:250ms from:#area-q, change">
				<div class="field-wrap">
					<label class="sr-only" for="area-q">Search areas</label>
					@components.Icon("search", "icon-sm")
					<input class="field" id="area-q" name="q" type="search" placeholder="Search: Westlands, Two Rivers, students…" value={ f.Q }/>
				</div>
				@filterGroup("County", "county", f.County, areaCounties)
				@filterGroup("Cost", "cost", f.Cost, areaCosts)
				@filterGroup("Good for", "suits", f.Suits, areaSuits)
				<noscript><button class="btn btn--gold" type="submit">Filter</button></noscript>
			</form>
			@AreaResults(s, f)
		</div>
	</section>
}

templ filterGroup(legend, name, current string, opts []struct{ Value, Label string }) {
	<fieldset class="filter-group">
		<legend class="label">{ legend }</legend>
		<div class="cluster" style="--gap:.4rem">
			for _, o := range opts {
				<label class="pill-radio">
					<input class="sr-only" type="radio" name={ name } value={ o.Value } checked?={ o.Value == current }/>
					<span class="pill">{ o.Label }</span>
				</label>
			}
		</div>
	</fieldset>
}

templ AreaResults(s *data.Store, f AreaFilter) {
	{{ areas := FilterAreas(s, f) }}
	<div id="area-results" class="mt-6">
		<p class="small soft" role="status">
			Showing <strong>{ itoa(len(areas)) }</strong> of { itoa(len(s.Areas)) } areas
			if f.Query() != "" {
				· <a class="link" href="/nairobi#areas">Clear filters</a>
			}
		</p>
		if len(areas) == 0 {
			<div class="mt-4">
				@components.Callout("info", "No areas match") {
					<p>Try fewer filters, or a different spelling.</p>
				}
			</div>
		} else {
			<div class="area-grid mt-4">
				for _, a := range areas {
					@components.AreaCard(a, s.CountyName(a.County))
				}
			</div>
		}
	</div>
}

templ ruakaSpotlight(s *data.Store) {
	{{ r := s.Nairobi.Ruaka }}
	<section id="ruaka" class="section spotlight" aria-labelledby="ruaka-title">
		<div class="wrap">
			<div class="spotlight__head">
				<span class="chip chip--red">Kiambu County</span>
				<h2 id="ruaka-title" class="display-lg mt-3">{ r.Title }</h2>
				<p class="lede mt-3">{ r.Intro }</p>
			</div>
			<div class="spotlight__grid mt-6">
				<figure class="card card--pad spotlight__map">
					@ruakaDiagram()
					<figcaption class="small soft mt-2">Schematic: Ruaka sits just across the Nairobi–Kiambu border on Limuru Road.</figcaption>
				</figure>
				<div class="spotlight__blocks reveal-stagger">
					for _, b := range r.Sections {
						<article class="card card--pad">
							<h3>{ b.Title }</h3>
							<p class="soft mt-2">{ b.Body }</p>
							if len(b.Points) > 0 {
								<ul class="checklist mt-3">
									for _, p := range b.Points {
										<li>
											@components.Icon("check", "icon-sm")
											<span>{ p }</span>
										</li>
									}
								</ul>
							}
						</article>
					}
				</div>
			</div>
		</div>
	</section>
}

templ ruakaDiagram() {
	<svg viewBox="0 0 360 300" role="img" aria-labelledby="ruaka-svg-title">
		<title id="ruaka-svg-title">Schematic of Ruaka: Nairobi to the south, Kiambu to the north, Limuru Road running north through Gigiri past Two Rivers Mall to Ruaka, and the Northern Bypass running east to west just north of the border</title>
		<rect x="0" y="0" width="360" height="160" fill="var(--c-kiambu)"></rect>
		<rect x="0" y="0" width="360" height="160" fill="url(#hatch-r)"></rect>
		<rect x="0" y="160" width="360" height="140" fill="var(--c-nairobi)"></rect>
		<defs>
			<pattern id="hatch-r" width="10" height="10" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><path d="M0 0 V10" stroke="var(--ink)" stroke-opacity=".12" stroke-width="3"></path></pattern>
		</defs>
		<path d="M0 160 H360" stroke="var(--red)" stroke-width="3" stroke-dasharray="10 6"></path>
		<text x="352" y="152" text-anchor="end" class="diagram-county">KIAMBU</text>
		<text x="352" y="182" text-anchor="end" class="diagram-county">NAIROBI</text>
		<path d="M150 300 C150 240 160 200 170 160 S190 80 200 20" class="road road--highway"></path>
		<text x="210" y="40" class="diagram-road">Limuru Rd → Limuru</text>
		<path d="M0 120 C100 110 220 128 360 112" class="road road--bypass"></path>
		<text x="8" y="108" class="diagram-road">Northern Bypass</text>
		<circle cx="190" cy="95" r="9" class="diagram-dot"></circle>
		<text x="204" y="100" class="diagram-place">Ruaka</text>
		<rect x="152" y="148" width="22" height="16" rx="3" class="diagram-mall"></rect>
		<text x="182" y="160" class="diagram-place-sm">Two Rivers Mall</text>
		<circle cx="150" cy="226" r="7" class="diagram-dot diagram-dot--nbo"></circle>
		<text x="162" y="231" class="diagram-place-sm">Gigiri · Village Market</text>
		<text x="140" y="292" text-anchor="end" class="diagram-place-sm">↓ Westlands, CBD</text>
	</svg>
}

templ gettingAround(s *data.Store) {
	{{ mt := s.Nairobi.Matatu }}
	<section id="getting-around" class="section section--alt" aria-labelledby="ga-title">
		<div class="wrap">
			<div class="section-head">
				<p class="eyebrow">Stop 3 · Getting around</p>
				<h2 id="ga-title" class="display-lg">Matatu, boda, app or train?</h2>
			</div>
			<ul class="transport-grid reveal-stagger mt-6">
				for _, b := range s.Nairobi.Transport {
					<li id={ "go-" + b.Slug } class="card transport">
						@components.Art(b.Icon, "transport__art")
						<h3>{ b.Title }</h3>
						<p class="soft">{ b.Body }</p>
						if len(b.Points) > 0 {
							<ul class="checklist small mt-3">
								for _, p := range b.Points {
									<li>
										@components.Icon("check", "icon-sm")
										<span>{ p }</span>
									</li>
								}
							</ul>
						}
					</li>
				}
			</ul>
			<div class="split mt-7">
				<div>
					<h3 class="cluster">
						@components.Art("matatu", "icon-lg")
						Reading a matatu
					</h3>
					<p class="soft mt-3">{ mt.Intro }</p>
					<ul class="colour-notes mt-4">
						for _, c := range mt.Colours {
							<li class="colour-note">
								<span class="colour-note__swatch" style={ templ.SafeCSS("background:" + components.SafeColour(c.Swatch)) }></span>
								<span><strong>{ c.Name }.</strong> { c.Meaning }</span>
							</li>
						}
					</ul>
					<ul class="checklist mt-5">
						for _, t := range mt.Tips {
							<li>
								@components.Icon("check", "icon-sm")
								<span>{ t }</span>
							</li>
						}
					</ul>
				</div>
				<div>
					<h3>Route numbers you’ll see</h3>
					<p class="small muted mt-2">Examples only: numbers and routes change, so always ask at the stage.</p>
					<ul class="route-boards mt-4">
						for _, r := range mt.Routes {
							<li class="route-board">
								<span class="route-board__num num">{ r.Number }</span>
								<span class="route-board__to"><small>{ r.From } →</small>{ r.To }</span>
							</li>
						}
					</ul>
					<div class="mt-6">
						@guideCard(s.Nairobi.Traffic)
					</div>
				</div>
			</div>
		</div>
	</section>
}

templ guideCard(b data.GuideBlock) {
	<article id={ b.Slug } class="card card--pad guide-card">
		<div class="guide-card__head">
			@components.Art(b.Icon, "guide-card__art")
			<h3>{ b.Title }</h3>
		</div>
		if b.Body != "" {
			<p class="soft mt-3">{ b.Body }</p>
		}
		if len(b.Points) > 0 {
			<ul class="checklist mt-3">
				for _, p := range b.Points {
					<li>
						@components.Icon("check", "icon-sm")
						<span>{ p }</span>
					</li>
				}
			</ul>
		}
	</article>
}

templ practical(s *data.Store) {
	<section id="practical" class="section" aria-labelledby="pr-title">
		<div class="wrap">
			<div class="section-head">
				<p class="eyebrow">Practical</p>
				<h2 id="pr-title" class="display-lg">SIM cards, food, safety and manners.</h2>
			</div>
			<div class="guide-grid mt-6 reveal-stagger">
				@guideCard(s.Nairobi.SIM)
				@guideCard(s.Nairobi.Food)
				@guideCard(s.Nairobi.Safety)
				@guideCard(s.Nairobi.Etiquette)
			</div>
			<ul class="food-strip mt-7" aria-label="Foods you’ll meet">
				for _, fd := range foods {
					<li>
						@components.Art(fd.Art, "food-strip__art")
						<span><strong>{ fd.Name }</strong><small>{ fd.Note }</small></span>
					</li>
				}
			</ul>
		</div>
	</section>
}

templ weatherSection(w data.Weather) {
	<section id="weather" class="section section--alt" aria-labelledby="wx-title">
		<div class="wrap">
			<div class="section-head">
				<p class="eyebrow">Weather</p>
				<h2 id="wx-title" class="display-lg">Mild, with two rainy seasons.</h2>
				<p class="lede">{ w.Summary }</p>
			</div>
			<div class="chart-pair mt-6">
				@components.TempChart(w.Months)
				@components.RainChart(w.Months)
			</div>
			<details class="card card--pad mt-4">
				<summary class="label" style="cursor:pointer;margin:0">Show the numbers as a table</summary>
				<div class="table-scroll mt-3">
					<table class="data-table">
						<caption class="sr-only">Approximate monthly climate for Nairobi</caption>
						<thead><tr><th scope="col">Month</th><th scope="col">Avg high</th><th scope="col">Avg low</th><th scope="col">Rain</th></tr></thead>
						<tbody>
							for _, mo := range w.Months {
								<tr><th scope="row">{ mo.Name }</th><td class="num">~{ fmtNum(mo.HighC) }°C</td><td class="num">~{ fmtNum(mo.LowC) }°C</td><td class="num">~{ fmtNum(mo.RainMM) } mm</td></tr>
							}
						</tbody>
					</table>
				</div>
			</details>
			<p class="small muted mt-3">
				@components.Approx("")
				{ w.Source }.
			</p>
			<div class="guide-grid mt-6">
				for _, se := range w.Seasons {
					<article class="card card--pad">
						<h3>{ se.Title }</h3>
						<p class="soft mt-2">{ se.Body }</p>
					</article>
				}
			</div>
		</div>
	</section>
}
