package pages

import (
	"workshop/internal/views/components"
	"workshop/internal/views/layouts"
)

type swatch struct{ Name, Var, Light, Dark, Use string }

var swatches = []swatch{
	{"Sand paper", "--paper", "#f6eedc", "#12142e", "Page background"},
	{"Bone", "--surface", "#fff9ec", "#1b1f4b", "Cards"},
	{"Ink", "--ink", "#1e1a16", "#f3ead7", "Text and outlines"},
	{"Rift Valley green", "--green", "#1f5c3f", "#5fb98a", "Links, primary"},
	{"Laterite red", "--red", "#b4432a", "#e88a70", "Eyebrows, warnings"},
	{"Savannah gold", "--gold", "#d9a21b", "#e8b931", "Buttons and highlights, always with ink text"},
	{"Night indigo", "--night", "#1b1f4b", "#0b0d24", "Footer, result panels, dark mode"},
	{"Lake blue", "--lake", "#2c7a9b", "#6fb3d2", "Water on maps"},
	{"Dry grass", "--muted", "#6b5b45", "#b9ac94", "Secondary text"},
}

var iconNames = []string{"money", "map", "bus", "city", "phone", "shield", "pin", "search", "food", "cloud", "compare", "book", "swap", "info", "alert", "check"}

templ DesignSystem(m layouts.Meta) {
	@layouts.Base(m) {
		@components.SectionHero(components.HeroProps{Eyebrow: "For editors", Title: "Design system", Lede: "The colours, lettering and building blocks every page uses. Edit them in static/css/app.css.", Motif: "highland"})
		<div class="wrap section stack" style="--flow:4rem">
			<section aria-labelledby="ds-colours">
				<h2 id="ds-colours" class="display-md">Colours</h2>
				<ul class="grid-auto mt-5">
					for _, sw := range swatches {
						<li class="card swatch">
							<span class="swatch__chip" style={ templ.SafeCSS("background:var(" + sw.Var + ")") }></span>
							<div>
								<p><strong>{ sw.Name }</strong></p>
								<p class="num small muted">{ sw.Light } / { sw.Dark }</p>
								<p class="small soft">{ sw.Use }</p>
							</div>
						</li>
					}
				</ul>
			</section>
			<section aria-labelledby="ds-type" class="stack">
				<h2 id="ds-type" class="display-md">Lettering</h2>
				<p class="display-xl">Karibu sana</p>
				<p class="display-lg">Bricolage Grotesque for headings</p>
				<p class="lede">Figtree for reading: friendly, open, and easy to read at small sizes on a phone in the sun.</p>
				<p class="num">KSh 1,250 · USh 45,000 · 07:30 EAT</p>
				<p class="jina display-md" lang="sw">“Haba na haba hujaza kibaba”</p>
			</section>
			<section aria-labelledby="ds-ui" class="stack" style="--flow:1.5rem">
				<h2 id="ds-ui" class="display-md">Buttons, chips and markers</h2>
				<div class="cluster">
					<a class="btn btn--gold" href="#ds-ui">Gold button</a>
					<a class="btn btn--green" href="#ds-ui">Green button</a>
					<a class="btn btn--red" href="#ds-ui">Red button</a>
					<a class="btn" href="#ds-ui">Plain button</a>
				</div>
				<div class="cluster">
					<span class="chip">Chip</span>
					<span class="chip chip--gold">Upmarket</span>
					<span class="chip chip--green">Good for families</span>
					<span class="chip chip--red">Kiambu County</span>
					@components.Approx("")
					@components.Approx("as of 2026")
					@components.LastReviewed(m.Site.LastReviewed)
				</div>
				<div class="cluster">
					<button type="button" class="pill" aria-pressed="true">All regions</button>
					<button type="button" class="pill" aria-pressed="false">Coast</button>
					<button type="button" class="pill" aria-pressed="false">Rift Valley</button>
				</div>
				<ul class="icon-grid">
					for _, n := range iconNames {
						<li class="card card--flat" title={ n }>
							@components.Icon(n, "icon-lg")
							<span class="sr-only">{ n }</span>
						</li>
					}
				</ul>
			</section>
			<section aria-labelledby="ds-blocks" class="stack" style="--flow:1.5rem">
				<h2 id="ds-blocks" class="display-md">Blocks</h2>
				<div class="grid-auto">
					@components.Callout("tip", "A tip") {
						<p>Gold callouts are for friendly hints.</p>
					}
					@components.Callout("info", "Good to know") {
						<p>Green callouts explain things.</p>
					}
					@components.Callout("warn", "Watch out") {
						<p>Red callouts are for scams and safety.</p>
					}
				</div>
				@components.KangaBand()
				<div class="kanga-thin"></div>
				<div class="grid-auto">
					<div class="card kitenge-dots pattern-tile"></div>
					<div class="card kitenge-waves pattern-tile"></div>
					@components.PhotoSlot("", "", "Nairobi skyline at dusk, 4:3")
				</div>
			</section>
		</div>
	}
}

templ NotFound(m layouts.Meta) {
	@layouts.Base(m) {
		@components.SectionHero(components.HeroProps{
			Eyebrow: "404 · Umepotea?",
			Title:   "Looks like you took the wrong matatu.",
			Lede:    "“Umepotea?” means “Are you lost?” It happens to everyone, locals included. This page doesn’t exist, but these do:",
			Motif:   "savannah",
		}) {
			<div class="cluster hero__actions">
				<a class="btn btn--gold" href="/">Back to the start</a>
				<a class="btn" href="/money">Money</a>
				<a class="btn" href="/nairobi">Nairobi guide</a>
			</div>
		}
	}
}
