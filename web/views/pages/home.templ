package pages

import "workshop/web/views/layout"

templ Home() {
	@layout.Base(layout.BaseProps{
		Title:       "Your site",
		Description: "An empty starter page. Add your own look and content here.",
	}) {
		<section class="hero">
			<div class="container">
				<h1>Your site</h1>
				<p class="hero__lead">Blank page. Tell me what this site is for, and we build that.</p>
			</div>
		</section>
	}
}
